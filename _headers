# Question banks and notes change with releases: short cache, then revalidate.
# Opened directly in a browser they may do nothing (no scripts, no framing).
/data/*
  Cache-Control: public, max-age=300, must-revalidate
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'

# Icons and fonts keep their file names, so no "immutable". One day, not a
# week: when the favicons or the app icon change (the KaiSip rename did), a
# returning visitor sees the new ones within a day. Fonts barely notice.
/assets/*
  Cache-Control: public, max-age=86400
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'
