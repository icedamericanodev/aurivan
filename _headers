# Host-neutral response headers (Netlify and Cloudflare Pages read this file
# as-is; other static hosts ignore it, and the site works without it).
# No Content-Security-Policy here on purpose: the app uses inline scripts and
# styles plus Google Analytics, Fonts and Forms. Add one only after testing.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# The app and public pages: always revalidate so a new release shows at once.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Question banks and notes change with releases: short cache, then revalidate.
/data/*
  Cache-Control: public, max-age=300, must-revalidate

# Icons keep their file names, so no "immutable".
/assets/*
  Cache-Control: public, max-age=604800
