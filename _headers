# Response headers for the website (Cloudflare Pages reads this file; so does
# Netlify. GitHub Pages ignores it, and the site works without it).
# scripts/build_site.sh copies it into _site/. Deploy notes:
# docs/WEBSITE_DEPLOY.md.
#
# HOW TO READ IT: a line with no indent is a path; the indented lines under
# it are the headers sent for that path. `*` matches anything.
#
# IMPORTANT (Cloudflare): when two rules match one path, Cloudflare JOINS
# their values for the same header name. So:
#   - the catch-all /* rule below has NO Cache-Control (each path sets its own);
#   - its Content-Security-Policy is the web app's policy. A joined policy is
#     safe: the browser reads "A, B" as two policies and enforces BOTH, so a
#     path with its own stricter policy (the legal pages, /data, /assets)
#     stays at least that strict. Any other address (Cloudflare shows the app
#     for an unknown path) still gets the app's policy.
# Cloudflare serves /privacy.html at /privacy (it drops ".html"), so each page
# is listed both ways. A new page needs its own rule here (and a line in
# scripts/build_site.sh).

# Every response.
#   HSTS: browsers use HTTPS only for this site for a year. ("preload" is left
#   out on purpose; add it only after this has run for a month.)
#   Content-Security-Policy (ENFORCED, web v12.28): what the web app loads and
#   nothing else. Scripts: this site, the inline scripts and onclick handlers
#   ('unsafe-inline' stays until they move into a .js file), Google Analytics
#   (loaded only after the visitor accepts) and Cloudflare Web Analytics.
#   Fonts are self-hosted. Connections: this site, the Google Forms used for
#   feedback and flags, Google Analytics, Cloudflare Web Analytics. No
#   plugins, no <base>, no framing.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com/gtag/js https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://docs.google.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://cloudflareinsights.com; frame-src https://docs.google.com; form-action https://docs.google.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'

# The web app: its policy comes from the /* rule above (one policy, so
# nothing to join here).
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# The legal pages have one tiny inline script (it applies the theme saved by
# the app), allowed by its exact hash; scripts/build_site.sh fails if the
# script changes without the hash here. Otherwise their policy is ENFORCED
# and strict: only this site's styles, images and fonts. The one script host
# allowed is Cloudflare Web Analytics, which Cloudflare adds to every page
# when it is switched on.
/privacy
  Cache-Control: public, max-age=0, must-revalidate
  Content-Security-Policy: default-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; script-src 'sha256-nbMPt7DJNCogX1hWKTLNy0Fg4H3+bU/3Jfci1NXG084=' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
/privacy.html
  Cache-Control: public, max-age=0, must-revalidate
  Content-Security-Policy: default-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; script-src 'sha256-nbMPt7DJNCogX1hWKTLNy0Fg4H3+bU/3Jfci1NXG084=' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
