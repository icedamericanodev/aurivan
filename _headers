# Question banks and notes change with releases: short cache, then revalidate.
# Opened directly in a browser they may do nothing (no scripts, no framing).
/data/*
  Cache-Control: public, max-age=300, must-revalidate
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'

# Icons (and later fonts) keep their file names, so no "immutable".
/assets/*
  Cache-Control: public, max-age=604800
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'
