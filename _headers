# The Beta Desk (private admin tracker). Never indexed, never cached (it
# shows tester details once an admin signs in), and a strict policy of its
# own: this site's code and fonts, the one theme script (by hash), the
# Supabase project, and Cloudflare Turnstile for the sign-in check.
# scripts/build_site.sh fails if noindex or no-store goes missing here.
/beta-desk
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-nbMPt7DJNCogX1hWKTLNy0Fg4H3+bU/3Jfci1NXG084=' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src https://ziadnvepttlgcowvqvom.supabase.co; frame-src https://challenges.cloudflare.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
/beta-desk.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-nbMPt7DJNCogX1hWKTLNy0Fg4H3+bU/3Jfci1NXG084=' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src https://ziadnvepttlgcowvqvom.supabase.co; frame-src https://challenges.cloudflare.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

