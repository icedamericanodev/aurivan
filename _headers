# The unlisted preview of the web study app while the site is closed to a
# landing page (scripts/build_site.sh, PREVIEW_DIR). Not for search engines,
# and always fresh. Remove this rule when the web app reopens at launch.
/preview-u63raxyfxc/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=0, must-revalidate

# Question banks and notes change with releases: short cache, then revalidate.
# Opened directly in a browser they may do nothing (no scripts, no framing).
/data/*
  Cache-Control: public, max-age=300, must-revalidate
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'

# Icons and fonts keep their file names, so no "immutable". One day, not a
# week: when the favicons or the app icon change (the KaiSip rename did), a
# returning visitor sees the new ones within a day. Fonts barely notice.
/assets/*
  Cache-Control: public, max-age=86400
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'

# The Beta Desk's code: always re-checked, so the page and its code never
# drift apart (joined with the /assets/* rule above: no-cache wins).
/assets/beta-desk.js
  Cache-Control: no-cache
  X-Robots-Tag: noindex
