scripts/__pycache__/

# Question bank source spreadsheets are not redistributed via this repo.
# Keep your local copy outside the repo or in this ignore list.
*.xlsm
*.xlsx
*.xls

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp

# Local secrets and Supabase CLI state (cloud features, Uplift Phase 6).
# Example files with empty values stay tracked.
.env
.env.*
!.env.example
supabase/.env
supabase/functions/.env
supabase/.temp/
supabase/.branches/
# The leak guard's fingerprint of the question bank (Phase 8): built at deploy
# time by scripts/build-leakprint.mjs, never committed.
supabase/functions/board-submit/leakprint.json

# Signing keys and certificates, anywhere in the repo (the repo is public).
# The Apple .p8 for Sign in with Apple revocation, a Play upload keystore or a
# provisioning profile must never be committed: they belong in Supabase
# function secrets or EAS credentials. scripts/check_secrets.sh (G1) also
# fails on any tracked file with these extensions. Nothing tracked matches
# them today (checked with `git ls-files`), so nothing tracked is hidden.
*.p8
*.p12
*.jks
*.keystore
*.pem
*.key
*.mobileprovision

# The website build output (scripts/build_site.sh); Cloudflare Pages builds it.
_site/
