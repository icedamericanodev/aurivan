{
  "expo": {
    "name": "KaiSip",
    "slug": "aurivan",
    "owner": "icedamericanodev",
    "scheme": "kaisip",
    "version": "1.52.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3F1EA",
    "ios": {
      "bundleIdentifier": "com.kaisip.app",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "Lets you save your KaiSip progress card to Photos when you choose Save Image."
      }
    },
    "android": {
      "package": "com.kaisip.app",
      "adaptiveIcon": {
        "backgroundColor": "#1E4A34",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": true,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F3F1EA",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#1E4A34"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# KaiSip: Bouncy Castle (used by expo-updates) has desktop-only LDAP code that\n# refers to javax.naming, which Android does not have. That code never runs on\n# a phone, so R8 must not stop the build over the missing classes.\n-dontwarn javax.naming.**\n"
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/fraunces/500Medium/Fraunces_500Medium.ttf",
            "./node_modules/@expo-google-fonts/fraunces/400Regular_Italic/Fraunces_400Regular_Italic.ttf",
            "./node_modules/@expo-google-fonts/figtree/400Regular/Figtree_400Regular.ttf",
            "./node_modules/@expo-google-fonts/figtree/500Medium/Figtree_500Medium.ttf",
            "./node_modules/@expo-google-fonts/figtree/600SemiBold/Figtree_600SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "TodayPlan",
              "label": "Today’s plan",
              "description": "What to study today, and one tap to start.",
              "minWidth": "130dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "300dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/plan.png",
              "updatePeriodMillis": 10800000
            },
            {
              "name": "YourPlant",
              "label": "Your plant",
              "description": "Your plant, growing as your answers stick.",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "300dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/plant.png",
              "updatePeriodMillis": 10800000
            },
            {
              "name": "TodaysRule",
              "label": "Today’s rule",
              "description": "One exam rule a day. Think of your answer, then check it.",
              "minWidth": "130dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "300dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/think.png",
              "updatePeriodMillis": 10800000
            },
            {
              "name": "ThisWeek",
              "label": "This week",
              "description": "The days you studied this week, shown as leaves.",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "220dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/week.png",
              "updatePeriodMillis": 10800000
            },
            {
              "name": "QuickQuestion",
              "label": "Quick question",
              "description": "One practice question a day. Answer it in the app.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "340dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/question.png",
              "updatePeriodMillis": 10800000
            },
            {
              "name": "Revisit",
              "label": "Questions to revisit",
              "description": "How many questions to revisit are in today’s plan.",
              "minWidth": "130dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "300dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/revisit.png",
              "updatePeriodMillis": 10800000
            },
            {
              "name": "ExamCountdown",
              "label": "Exam countdown",
              "description": "Weeks to your exam. Asks you first when you add it.",
              "minWidth": "130dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "300dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/countdown.png",
              "updatePeriodMillis": 10800000,
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "Readiness",
              "label": "Readiness",
              "description": "Your study estimate as rings. Asks you first when you add it.",
              "minWidth": "130dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "300dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/readiness.png",
              "updatePeriodMillis": 10800000,
              "widgetFeatures": "reconfigurable"
            }
          ]
        }
      ],
      "./plugins/withWidgetBackupRules"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/992746e8-946f-49c0-8a95-67e1e80b2272",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "992746e8-946f-49c0-8a95-67e1e80b2272"
      }
    }
  }
}
