{
  "expo": {
    "name": "KaiSip",
    "slug": "aurivan",
    "owner": "icedamericanodev",
    "scheme": "kaisip",
    "version": "1.25.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3F1EA",
    "ios": {
      "bundleIdentifier": "com.kaisip.app",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "Lets you save your KaiSip progress card to Photos when you choose Save Image."
      }
    },
    "android": {
      "package": "com.kaisip.app",
      "adaptiveIcon": {
        "backgroundColor": "#1E4A34",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": true,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F3F1EA",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#1E4A34"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# KaiSip: Bouncy Castle (used by expo-updates) has desktop-only LDAP code that\n# refers to javax.naming, which Android does not have. That code never runs on\n# a phone, so R8 must not stop the build over the missing classes.\n-dontwarn javax.naming.**\n"
          }
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/992746e8-946f-49c0-8a95-67e1e80b2272",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "992746e8-946f-49c0-8a95-67e1e80b2272"
      }
    }
  }
}
