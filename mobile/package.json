    "setupFiles": [
      "<rootDir>/jest/setup.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest/after-env.ts"
    ]
  },
  "overrides": {
    "node-forge": "1.4.2",
    "zod": "4.6.6"
