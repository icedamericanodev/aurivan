    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "shots": "bash scripts/screenshots/run.sh",
    "content": "node scripts/build-content.mjs",
    "postinstall": "node scripts/build-content.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
