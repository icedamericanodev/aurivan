# Copy this file to .env.local and fill in the values.
# EXPO_PUBLIC_* values are bundled into the app (public) — never put secrets here.
# Privacy policy and Terms of use links. Optional: left empty (or not an https:// link),
# the app uses https://kaisip.com/privacy and https://kaisip.com/terms, so the
# Settings rows never disappear (mobile 1.40.1). Cloud builds must set both (configGuard.ts).
EXPO_PUBLIC_PRIVACY_URL=https://your-domain.example/privacy.html
EXPO_PUBLIC_TERMS_URL=https://your-domain.example/terms.html
# Where "Report a problem", "Send feedback" and "Contact support" emails go.
# Optional: left empty (or not a valid address), the app uses its built-in
# default, certprep.support@gmail.com, so reporting is never switched off.
EXPO_PUBLIC_FEEDBACK_EMAIL=

# ── Accounts, sync and the feedback board (built OFF; docs/mobile/ARCHITECTURE.md "Cloud (built OFF)") ──
# The one switch. Unset (or empty) = OFF, which is every build today. Only "1" turns it on.
EXPO_PUBLIC_AURIVAN_CLOUD=
# Sign-in methods, comma-separated (default: email,apple,google).
EXPO_PUBLIC_AURIVAN_CLOUD_PROVIDERS=
# "memory" = the in-memory demo backend: local dev and the screenshot build only (never in an EAS profile).
EXPO_PUBLIC_AURIVAN_CLOUD_BACKEND=
# Set to 1 only by the screenshot harness (SHOTS=cloud).
EXPO_PUBLIC_AURIVAN_SHOTS=
# Phase 9 (go-live): the project URL (https://…) and the PUBLISHABLE key only.
# The service-role / secret key never goes here, in eas.json or in EAS env: it lives in Supabase function secrets.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Not EXPO_PUBLIC (never bundled): the owner sets it to "yes" on the production profile at Phase 9 only.
AURIVAN_CLOUD_GO_LIVE_ACK=
